# =============================================================================
# wazuh-waha - Variables de entorno
# =============================================================================
# Copia este archivo a .env y completa los valores. .env NO se commitea.
#
# Para generar API keys seguras:
#   openssl rand -hex 24   # 48 chars
# =============================================================================

# --- Server Wazuh (manager) ---
# IP UNICA del manager Wazuh. Cambiar aca y todo el repo se actualiza via
# scripts/render_manager_snippet.py y los defaults de scripts/diagnose.sh.
# Esta es la fuente de verdad.
# WAZUH_MANAGER_HOST y WAZUH_VM_SSH_HOST son aliases deprecated; si estan
# seteados en .env tienen prioridad por compatibilidad con scripts viejos.
WAZUH_SERVER_IP=192.168.1.72

# IPs candidatas si la IP principal se cae (separadas por coma, sin espacios).
# Usada por watch_manager_ip.sh para detectar drift. Si no se setea, no hay
# auto-descubrimiento - solo avisa que el manager no responde.
WAZUH_SERVER_IP_FALLBACK=172.44.30.5

# Setear a 1 para que watch_manager_ip.sh actualice ossec.conf del agente
# automaticamente cuando detecta drift. Default 0 (avisa, pero requiere
# aprobacion manual). PELIGROSO si no confias en las IPs candidatas.
AUTO_RECONCILE=0

# --- Relay (servicio wazuh-waha) ---
RELAY_PORT=8765
RELAY_BIND=0.0.0.0
RELAY_API_KEY=***  # openssl rand -hex 24
RELAY_DEDUP_TTL=300
RELAY_MIN_LEVEL_UNKNOWN=10   # alerts sin template solo si level >= este valor
RELAY_LOG_DIR=/var/log/wazuh-waha
RELAY_LIB_DIR=/var/lib/wazuh-waha
RELAY_WORKERS=2   # cantidad de workers uvicorn (multi-proceso)
RELAY_LIFESPAN_TIMEOUT=10   # segundos esperando startup

# --- WhatsApp destino ---
ADMIN_PHONE=                  # formato: 5219991234567 (sin +)

# --- WAHA (WhatsApp HTTP API, en Docker) ---
WAHA_API_KEY=*** 48 chars
WAHA_HOST=http://localhost:3000
WAHA_SESSION=default
WAHA_LOG_LEVEL=info
WAHA_HOOK_URL=

# --- Ollama (IA local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=10
OLLAMA_ENABLED=false   # false = no usa IA, solo templates (recomendado)

# --- Diagnostico (opcional) ---
# DEPRECATED: usar WAZUH_SERVER_IP. Mantenido por compat con scripts viejos.
WAZUH_MANAGER_HOST=192.168.1.72
WAZUH_MANAGER_API_USER=wazuh
WAZUH_MANAGER_API_PASS=    # pass de la API REST del manager
WAZUH_VM_SSH_USER=tadeou7
# DEPRECATED: usar WAZUH_SERVER_IP. Mantenido por compat con scripts viejos.
WAZUH_VM_SSH_HOST=192.168.1.72
WAZUH_VM_SSH_PORT=22
# NOTA: la pass SSH se lee de WAZUH_VM_SSH_PASS en runtime, NO la pongas aca.

# --- Wazuh Manager API (para reportar health events de WAHA) ---
# El relay postea alertas de tipo "waha_health" (rule_id 999001) a este endpoint.
# Si las dejas vacias, ese canal se desactiva (sigue funcionando email si esta configurado).
WAZUH_MANAGER_API_PORT=55000
WAZUH_MANAGER_API_VERIFY_TLS=false

# --- Email backup (opcional, vacio = desactivado) ---
# Se usa cuando la sesion WAHA se cae, como canal adicional al Wazuh API.
# EMAIL_PROVIDER puede ser "smtp" (directo) o "hyvor_relay" (API self-hosted).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=wazuh-waha@localhost
ADMIN_EMAIL="tu@correo.com"
SMTP_TLS=true

# --- Hyvor Relay (email API auto-hosteada, alternativa a SMTP directo) ---
# Requiere tener Hyvor Relay corriendo (docker) con PostgreSQL + OIDC.
# Docs de setup: https://relay.hyvor.com/hosting
# Repo: /home/tadeo/Desktop/relay/
# Cuando EMAIL_PROVIDER=hyvor_relay, se usa esta seccion en vez de SMTP_*.
HYVOR_BASE_URL=           # ej: http://localhost:8000 o https://relay.midominio.com
HYVOR_API_KEY=            # API key con scope sends.send (generada en Console > API)
HYVOR_FROM=wazuh-waha@midominio.com  # debe ser dominio verificado en Hyvor

# --- Auto-recovery de sesion WAHA ---
# Cooldown entre intentos de auto-recovery (segundos). Default 300 = 5 min.
# Evita loop si el recovery falla repetidamente.
WAHA_RECOVERY_COOLDOWN_SEC=300
# Tiempo maximo (segundos) esperando que la sesion vuelva a WORKING.
WAHA_RECOVERY_MAX_WAIT_SEC=60
# Cada cuantos segundos el watchdog chequea la sesion WAHA.
WAHA_WATCHDOG_INTERVAL_SEC=300
