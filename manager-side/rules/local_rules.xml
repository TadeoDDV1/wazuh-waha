<!--
  =============================================================================
  Reglas locales para Wazuh - Login exitoso + Health events del pipeline
  =============================================================================
  Copiar a la VM en: /var/ossec/etc/rules/local_rules.xml
  Reiniciar manager:  sudo systemctl restart wazuh-manager

  Reglas 57100-57106 suben el level de los eventos de "login exitoso"
  que por defecto estan en level 3 (informational, debajo del umbral 10
  del integration) a level 8-12, para que disparen el WhatsApp.

  Regla 999001 matchea alertas generadas por el relay wazuh-waha cuando
  detecta problemas con la sesion WAHA. El relay las inyecta al manager
  via la API REST (endpoint /alerts puerto 55000). El manager las procesa
  y, si level >= 8, las manda al integration -> WhatsApp. Si WAHA esta
  caido, la alerta queda encolada y sale apenas vuelva.

  IDs usados:
    - 57100-57106  : login success (SSH, su, sudo, TTY)
    - 57107-57110  : vulnerability-detector (CVE)
    - 999001       : WAHA health event

  NOTA SOBRE if_sid: usamos una combinacion de <if_sid> (cuando estamos
  seguros del ID padre) Y <match> (regex sobre el log) para ser robustos.
  Si el ID padre cambia entre versiones de Wazuh, el <match> sigue
  funcionando.
  =============================================================================
-->

<group name="local,authentication_success,waha_health">

  <!-- 57100: SSH login exitoso - se cuelga de la regla stock 5715 (level 3 -> 10) -->
  <rule id="57100" level="10">
    <if_sid>5715</if_sid>
    <description>SSH login exitoso</description>
    <group>authentication_success,sshd</group>
  </rule>

  <!-- 57101: SSH login con clave publica -->
  <rule id="57101" level="10">
    <if_sid>57100</if_sid>
    <match>publickey</match>
    <description>SSH login exitoso con clave publica</description>
    <group>authentication_success,sshd,publickey</group>
  </rule>

  <!-- 57102: SSH login como root (CRITICO) -->
  <rule id="57102" level="12">
    <if_sid>57100</if_sid>
    <match>for root from</match>
    <description>SSH login exitoso como root (CRITICO)</description>
    <group>authentication_success,sshd,root_login</group>
  </rule>

  <!-- 57103: su exitoso (cambio de usuario) - se cuelga de PAM session opened si es su -->
  <rule id="57103" level="10">
    <if_sid>5501</if_sid>
    <match>su:session</match>
    <description>Cambio de usuario (su) exitoso</description>
    <group>authentication_success,su</group>
  </rule>

  <!-- 57104: sudo exitoso - se cuelga de las reglas stock 5402/5407 (level 3 -> 8) -->
  <rule id="57104" level="8">
    <if_sid>5402,5407</if_sid>
    <description>Comando sudo ejecutado con exito</description>
    <group>authentication_success,sudo</group>
  </rule>

  <!-- 57105: Login local (TTY/consola) - solo login/su, NO sshd -->
  <rule id="57105" level="8">
    <if_sid>5501</if_sid>
    <match>pam_unix(login:session): session opened for user</match>
    <description>Login local (TTY/consola) exitoso</description>
    <group>authentication_success,local</group>
  </rule>

  <!-- 57106: Logout / session closed - solo login/su, NO sshd -->
  <rule id="57106" level="3">
    <if_sid>5502</if_sid>
    <match>pam_unix(login:session): session closed for user</match>
    <description>Logout / sesion cerrada</description>
    <group>authentication_success,session_close</group>
  </rule>

  <!-- =========================================================================
    Reglas para Vulnerability Detector — CVE activas
    =========================================================================
    Los rule IDs stock del vulnerability-detector son:
      23501: Vulnerability affects a software package (level 5, padre)
      23503: Active LOW severity vulnerability (level 5)
      23504: Active MEDIUM severity (level 7)
      23505: Active HIGH severity (level 10)
      23506: Active CRITICAL severity (level 12)
      23502: Solved (level 3)
      23507: Cleared (level 3)
      23508: Awaiting CVE analysis (level 3)

    La integracion de WhatsApp solo se dispara con level >= 8. Las reglas
    stock 23505 (HIGH, level 10) y 23506 (CRITICAL, level 12) YA pasan el
    umbral. Las reglas 23503 (LOW, level 5) y 23504 (MEDIUM, level 7) no.
    Estas reglas custom elevan LOW y MEDIUM a level 8 para que tambien
    disparen el WhatsApp.
  -->

  <!-- 57107: CVE de severidad MEDIUM -> sube de level 7 a 8 -->
  <rule id="57107" level="8">
    <if_sid>23504</if_sid>
    <description>Vulnerabilidad MEDIA detectada</description>
    <group>vulnerability_detector,cve</group>
  </rule>

  <!-- 57108: CVE de severidad LOW -> sube de level 5 a 8 -->
  <rule id="57108" level="8">
    <if_sid>23503</if_sid>
    <description>Vulnerabilidad BAJA detectada</description>
    <group>vulnerability_detector,cve</group>
  </rule>

  <!-- 57109: CVE resuelta (solved) -> sube de level 3 a 8 para informar -->
  <rule id="57109" level="8">
    <if_sid>23502</if_sid>
    <description>Vulnerabilidad resuelta</description>
    <group>vulnerability_detector,cve,solved</group>
  </rule>

  <!-- 57110: CVE con estado "Clear" (todas limpiadas) -> sube de level 3 a 8 -->
  <rule id="57110" level="8">
    <if_sid>23507</if_sid>
    <description>Vulnerabilidades limpiadas</description>
    <group>vulnerability_detector,cve,clear</group>
  </rule>

  <!-- =========================================================================
    Nuevas Reglas de Seguridad Avanzadas (57120 - 57130)
    ========================================================================= -->

  <!-- 57120: Ataque de fuerza bruta SSH persistente (más de 8 fallos en 2 min) -->
  <rule id="57120" level="12" frequency="8" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <description>Ataque de fuerza bruta SSH persistente detectado</description>
    <group>authentication_failures,sshd,brute_force</group>
  </rule>

  <!-- 57121: Ejecución remota sospechosa por tubería (curl | bash, wget | sh) -->
  <rule id="57121" level="12">
    <if_sid>5402, 5407, 57104</if_sid>
    <match>curl | bash|wget | bash|curl | sh|wget | sh|python -c|perl -e</match>
    <description>Ejecucion remota sospechosa por tuberia (curl/wget a bash/sh)</description>
    <group>attack,remote_execution</group>
  </rule>

  <!-- 57122: Ejecución sospechosa de script/binario en /tmp, /dev/shm o /var/tmp -->
  <rule id="57122" level="11">
    <if_sid>5402, 5407, 57104</if_sid>
    <match>/tmp/|/dev/shm/|/var/tmp/</match>
    <description>Ejecucion de comando o binario en directorio temporal sospechoso</description>
    <group>suspicious_execution</group>
  </rule>

  <!-- 57123: Intento no autorizado en sudoers -->
  <rule id="57123" level="11">
    <if_sid>5405</if_sid>
    <description>Violacion de seguridad: usuario no autorizado ejecutando sudo</description>
    <group>authentication_failed,sudo,privilege_escalation</group>
  </rule>

  <!-- 57124: Intento reiterado de login directo como root por SSH -->
  <rule id="57124" level="11" frequency="4" timeframe="90">
    <if_matched_sid>5711</if_matched_sid>
    <match>user root|for root</match>
    <description>Multiples intentos fallidos de acceso directo como root por SSH</description>
    <group>authentication_failures,sshd,root_login</group>
  </rule>

  <!-- 57125: Modificación de archivos de sistema críticos (/etc/shadow, /etc/passwd, /etc/sudoers) -->
  <rule id="57125" level="12">
    <if_sid>550, 554</if_sid>
    <match>/etc/shadow|/etc/passwd|/etc/sudoers|/etc/ssh/sshd_config</match>
    <description>Modificacion no autorizada de archivo critico de autenticacion del sistema</description>
    <group>syscheck,tampering,integrity</group>
  </rule>

  <!-- 57126: Detención o caída de servicio crítico del sistema (wazuh, ssh, iptables) -->
  <rule id="57126" level="10">
    <match>Stopped Wazuh|Stopped OpenBSD Secure Shell|Stopping Wazuh|Stopping OpenBSD Secure Shell</match>
    <description>Detencion o parada de servicio critico del sistema de seguridad</description>
    <group>service_stop,availability</group>
  </rule>

  <!-- 57127: Kernel OOM Killer activado (Memoria RAM crítica agotada) -->
  <rule id="57127" level="10">
    <match>Out of memory: Killed process|invoked oom-killer</match>
    <description>Kernel OOM Killer activado: proceso terminado por agotamiento de RAM</description>
    <group>kernel,oom_killer,system_health</group>
  </rule>

  <!-- 57128: Escaneo de puertos detectado / bloqueado por firewall -->
  <rule id="57128" level="10">
    <match>UFW BLOCK|iptables denied|connection refused</match>
    <description>Escaneo de puertos o conexion bloqueada masiva por Firewall</description>
    <group>firewall,port_scan,reconnaissance</group>
  </rule>

  <!-- 57129: Modificación de claves autorizadas en .ssh/authorized_keys -->
  <rule id="57129" level="11">
    <if_sid>550, 554</if_sid>
    <match>authorized_keys</match>
    <description>Modificacion o adicion de claves en archivo authorized_keys de SSH</description>
    <group>syscheck,ssh_keys,persistence</group>
  </rule>

  <!-- 57130: Contenedor Docker caído o finalizado con código de error -->
  <rule id="57130" level="9">
    <match>container died|container exited with code|die container</match>
    <description>Contenedor Docker detenido o en fallo de ejecucion</description>
    <group>docker,container_health</group>
  </rule>

  <!-- 999001: Health event de WAHA / Relay / Agente. El relay inyecta estas alertas -->
  <!-- via POST al manager (puerto 55000 /events). -->
  <rule id="999001" level="10">
    <decoded_as>json</decoded_as>
    <match>WAHA session|wazuh-waha|wazuh-agent|watchdog</match>
    <description>Wazuh-WAHA infrastructure health event</description>
    <group>waha_health,auto_recovery</group>
  </rule>

</group>