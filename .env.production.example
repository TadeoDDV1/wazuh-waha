# =============================================================================
# wazuh-waha — configuración de PRODUCCIÓN
# =============================================================================
# Copiar a .env y completar. NUNCA commitear .env.
#   cp .env.production.example .env
#   chmod 600 .env
#
# Generar claves:
#   openssl rand -hex 24   # 48 chars
# =============================================================================

# --- Dominio y proxy ---
# Dominio público del dashboard (Caddy lo usa para TLS).
# Si no hay dominio, dejar vacío y acceder por túnel SSH/VPN a 127.0.0.1:8001.
DOMAIN=
# Orígenes permitidos por CORS (mismo origen en producción).
ALLOWED_ORIGINS=https://soc.example.com
# Redes de confianza para X-Forwarded-For (Caddy/proxy local).
TRUSTED_PROXIES=127.0.0.1,::1

# --- Wazuh Manager ---
# IP/host del manager. Si el relay corre en el mismo host, usar 127.0.0.1.
WAZUH_SERVER_IP=127.0.0.1
WAZUH_SERVER_IP_FALLBACK=
WAZUH_MANAGER_HOST=
WAZUH_MANAGER_API_PORT=55000
WAZUH_MANAGER_API_USER=wazuh-wui
WAZUH_MANAGER_API_PASS=CAMBIAR_PASSWORD_API_WAZUH
WAZUH_MANAGER_API_VERIFY_TLS=false
# Edición de ossec.conf desde el dashboard: dejar false en producción.
WAZUH_MANAGER_CONFIG_WRITE_ENABLED=false
AUTO_RECONCILE=0

# --- Telemetría / tráfico ---
# local = relay en el manager; ssh = manager remoto; api = solo API.
TRAFFIC_SOURCE=local
TRAFFIC_POLL_INTERVAL_SEC=1.5
TRAFFIC_JOURNAL_PATH=
WAZUH_ALERTS_JSON_PATH=/var/ossec/logs/alerts/alerts.json
# Solo si TRAFFIC_SOURCE=ssh:
WAZUH_VM_SSH_USER=wazuh
WAZUH_VM_SSH_PORT=22
WAZUH_VM_SSH_KEY_PATH=/etc/wazuh-waha/ssh/id_ed25519
WAZUH_VM_SSH_STRICT_HOST_KEY=yes

# --- Red real ---
NETWORK_POLL_INTERVAL_SEC=3
NETWORK_DNS_CACHE_TTL=3600
NETWORK_SSH_TARGETS=manager
NETWORK_ENABLE_PACKET_CAPTURE=false
NETWORK_PACKET_CAPTURE_FILTER=ip
NETWORK_PACKET_CAPTURE_MAX_EVENTS=50
NETWORK_MAX_CONNECTIONS=1500

# --- Enriquecimiento determinista (traducción + contexto para el dashboard) ---
ENRICH_ENABLED=true
ENRICH_CACHE_ENABLED=true
ENRICH_CACHE_PATH=/var/lib/wazuh-waha/enrichment_cache.sqlite3
ENRICH_CACHE_TTL_SEC=86400
ENRICH_CATALOG_DIR=
ENRICH_ASSETS_FILE=/etc/wazuh-waha/assets.json
ENRICH_GEOIP_DB=/var/lib/wazuh-waha/GeoLite2-City.mmdb
ENRICH_REDACT_PII=true
ENRICH_UI_SIMPLE_MODE_DEFAULT=true

# --- Relay ---
RELAY_PORT=8765
RELAY_BIND=127.0.0.1
RELAY_API_KEY=CAMBIAR_RELAY_API_KEY
RELAY_READONLY_API_KEY=
RELAY_DEDUP_TTL=300
RELAY_MIN_LEVEL_UNKNOWN=8
RELAY_LOG_DIR=/var/log/wazuh-waha
RELAY_LIB_DIR=/var/lib/wazuh-waha
RELAY_BACKUP_DIR=/var/backups/wazuh-waha
RELAY_BACKUP_ENABLED=true
RELAY_WORKERS=2
RELAY_LIFESPAN_TIMEOUT=10
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=true
MAX_BODY_BYTES=524288
ENABLE_DOCS=false

# --- WhatsApp (WAHA) ---
WHATSAPP_ENABLED=true
ADMIN_PHONE=
WAHA_API_KEY=CAMBIAR_WAHA_API_KEY
WAHA_HOST=http://127.0.0.1:3001
WAHA_SESSION=default
WAHA_LOG_LEVEL=info
WAHA_HOOK_URL=http://host.docker.internal:8765/api/v1/waha/webhook
WAHA_RECOVERY_COOLDOWN_SEC=300
WAHA_RECOVERY_MAX_WAIT_SEC=60
WAHA_WATCHDOG_INTERVAL_SEC=300

# --- Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_LEVEL=8

# --- Email ---
EMAIL_ALERTS_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=wazuh-waha@localhost
ADMIN_EMAIL=
SMTP_TLS=true
HYVOR_BASE_URL=
HYVOR_API_KEY=
HYVOR_FROM=wazuh-waha@localhost

# --- Consola web / SSH ---
# Requiere HTTPS/VPN. En producción se recomienda no habilitar shell local.
CONSOLE_ENABLED=true
CONSOLE_TARGETS=manager
CONSOLE_MAX_SESSIONS=2
CONSOLE_IDLE_TIMEOUT_SEC=900
CONSOLE_ABSOLUTE_TIMEOUT_SEC=3600
CONSOLE_RECORD_TRANSCRIPT=true
CONSOLE_ALLOW_LOCAL_SHELL=false
# Agentes opcionales: 001=usuario@ip,002=usuario@ip
CONSOLE_AGENT_TARGETS=

# --- Docker / puertos locales ---
WAHA_IMAGE=devlikeapro/waha:latest
WAHA_PUBLIC_PORT=3001
DASHBOARD_PUBLIC_PORT=8001
WAHA_MEM_LIMIT=3g
WAHA_CPUS=2.0

# --- Ollama (opcional) ---
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=10
