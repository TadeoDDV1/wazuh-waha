# Variables que systemd lee (EnvironmentFile=) para wazuh-waha en este host.
#
# INSTALACION:
#   1. Copiar a /etc/wazuh-waha/relay.env:
#        sudo cp relay.env.example /etc/wazuh-waha/relay.env
#   2. Completar valores (RELAY_API_KEY, WAHA_*, ADMIN_PHONE).
#   3. Permisos: sudo chmod 600 /etc/wazuh-waha/relay.env
#   4. sudo systemctl daemon-reload && sudo systemctl restart wazuh-waha

RELAY_API_KEY=*** # openssl rand -hex 24

RELAY_PORT=8765
RELAY_BIND=0.0.0.0
RELAY_DEDUP_TTL=300
RELAY_LOG_DIR=/var/log/wazuh-waha
RELAY_LIB_DIR=/var/lib/wazuh-waha
RELAY_WORKERS=2
RELAY_LIFESPAN_TIMEOUT=10

ADMIN_PHONE=                    # formato: 5219991234567 (sin +)

WAHA_API_KEY=*** 48 chars
WAHA_HOST=http://localhost:3000
WAHA_SESSION=default

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=10
OLLAMA_ENABLED=false

# --- Wazuh Manager API (canal principal de notificacion) ---
WAZUH_MANAGER_HOST=
WAZUH_MANAGER_API_PORT=55000
WAZUH_MANAGER_API_USER=wazuh
WAZUH_MANAGER_API_PASS=
WAZUH_MANAGER_API_VERIFY_TLS=false

# --- Email backup (opcional) ---
EMAIL_PROVIDER=smtp           # smtp | hyvor_relay
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=wazuh-waha@localhost
# Destino de todos los correos (notifier + test del dashboard)
ADMIN_EMAIL=
SMTP_TLS=true

# --- Hyvor Relay (alternativa a SMTP, via REST API) ---
HYVOR_BASE_URL=
HYVOR_API_KEY=
HYVOR_FROM=wazuh-waha@localhost

# --- Auto-recovery de sesion WAHA ---
WAHA_RECOVERY_COOLDOWN_SEC=300
WAHA_RECOVERY_MAX_WAIT_SEC=60
WAHA_WATCHDOG_INTERVAL_SEC=300
