[Unit]
Description=Cada 5 min detecta drift de IP del manager Wazuh y notifica
Documentation=file:///opt/wazuh-waha/README.md

[Timer]
# Despues del boot, esperar 2 minutos para que la red y el manager esten listos
OnBootSec=2min
# Luego cada 5 minutos
OnUnitActiveSec=300s
# Precision: si el timer se atrasa por suspension/hibernacion, disparar ASAP
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
