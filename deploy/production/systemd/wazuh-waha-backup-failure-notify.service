[Unit]
Description=wazuh-waha: aviso de respaldo fallido
Documentation=file://__APP_DIR__/README.md
After=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
EnvironmentFile=/etc/wazuh-waha/relay.env
ExecStart=/usr/bin/python3 __APP_DIR__/scripts/host_notify.py --event backup-failed --detail "El respaldo automatico fallo; revisar /var/log/wazuh-waha/backup.log" --with-status
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wazuh-waha-backup-failure-notify
