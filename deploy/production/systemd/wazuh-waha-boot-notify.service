[Unit]
Description=wazuh-waha: aviso cuando el servidor vuelve a estar en linea
Documentation=file://__APP_DIR__/README.md
After=network-online.target docker.service wazuh-waha.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
EnvironmentFile=/etc/wazuh-waha/relay.env
ExecStart=/usr/bin/python3 __APP_DIR__/scripts/host_notify.py --event boot --with-status
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wazuh-waha-boot-notify

[Install]
WantedBy=multi-user.target
