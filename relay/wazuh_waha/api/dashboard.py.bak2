# ──────────────────────────────────────────────
# Status checker (async wrapper)
# ──────────────────────────────────────────────

async def gather_status() -> dict[str, Any]:
    """Recolecta el estado de todos los componentes sincronicamente (subprocess no es async)."""
    results: list[dict] = []
    for comp in COMPONENTS:
        # Check WAHA session is async (httpx); everything else is sync
        if comp["status_type"] == "waha_session":
            wa_health, wa_detail = await _check_waha_session_async()
            results.append({
                "id": comp["id"],
                "name": comp["name"],
                "category": comp["category"],
                "icon": comp["icon"],
                "description": comp["description"],
                "health": wa_health,
                "detail": wa_detail,
                "toggleable": comp["toggleable"],
                "current_state": wa_health in ("healthy", "warning"),
                "actions": comp["actions"],
                "unit": comp.get("unit", ""),
            })
        else:
            result = _get_component_status_sync(comp)
            results.append(result)

    return {
        "host": os.uname().nodename,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "uptime_sec": int(time.time() - _boot_time()),
        "local_ip": _local_ip(),
        "components": results,
    }


async def _check_waha_session_async() -> tuple[str, str]:
    """Async version of check_waha_session."""
    if not settings.waha_host:
        return "disabled", "WAHA_HOST empty"
    try:
        async with httpx.AsyncClient(timeout=5, verify=False) as client:
            r = await client.get(
                f"{settings.waha_host}/api/sessions/{settings.waha_session}",
                headers={"X-Api-Key": settings.waha_api_key},
            )
            if r.is_success:
                data = r.json()
                s = data.get("status", "unknown")
                if s == "WORKING":
                    me = data.get("me", {})
                    name = me.get("name", "") if isinstance(me, dict) else ""
                    return "healthy", f"WORKING{f' ({name})' if name else ''}"
                elif s in ("STARTING", "STOPPED", "SCANNING_QR"):
                    return "warning", s
                else:
                    return "error", s
            else:
                return "error", f"HTTP {r.status_code}"
    except httpx.ConnectError:
        return "error", "WAHA unreachable"
    except Exception as e:
        return "error", str(e)[:120]


def _boot_time() -> float:
    try:
        with open("/proc/stat") as f:
            for line in f:
                if line.startswith("btime"):
                    return float(line.split()[1])
    except Exception:
        pass
    return time.time()


def _local_ip() -> str:
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 53))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "unknown"


# ──────────────────────────────────────────────
# Control helpers (Fase 2)
# ──────────────────────────────────────────────

def _toggle_systemd(unit: str, enabled: bool) -> tuple[bool, str]:
    """Enable/disable un systemd unit."""
    action = "enable" if enabled else "disable"
    code, out = _run_cmd(["sudo", "-n", "systemctl", action, unit, "--now"])
    if code == 0:
        return True, f"{action}d {unit}"
    # Intentar sin sudo (quizás el usuario ya tiene permisos)
    code2, out2 = _run_cmd(["systemctl", action, unit, "--now"])
    if code2 == 0:
        return True, f"{action}d {unit}"
    return False, f"failed: {out or out2}"


def _restart_service(unit: str) -> tuple[bool, str]:
    code, out = _run_cmd(["sudo", "-n", "systemctl", "restart", unit])
    if code == 0:
        return True, f"restarted {unit}"
    code2, out2 = _run_cmd(["systemctl", "restart", unit])
    if code2 == 0:
        return True, f"restarted {unit}"
    return False, f"failed: {out or out2}"


def _toggle_waha_session(start: bool) -> tuple[bool, str]:
    """Start/stop la sesión WAHA via su API."""
    action = "start" if start else "stop"
    url = f"{settings.waha_host}/api/sessions/{settings.waha_session}/{action}"
    try:
        r = subprocess.run(
            ["curl", "-sS", "-m", "10",
             "-H", f"X-Api-Key: {settings.waha_api_key}",
             "-X", "POST", url],
            capture_output=True, text=True, timeout=15,
        )
        if r.returncode == 0:
            return True, f"session {action}ed"
        return False, r.stderr.strip()[:200]
    except Exception as e:
        return False, str(e)


def _load_overrides() -> dict:
    """Lee el archivo de overrides desde relay_lib_dir."""
    try:
        from ..config import load_overrides
        return load_overrides()
    except Exception:
        return {}


def _save_overrides(data: dict) -> bool:
    """Guarda overrides en relay_lib_dir (writable por el service)."""
    try:
        from ..config import save_overrides
        save_overrides(data)
        return True
    except Exception as e:
        log.error("save_overrides_failed err=%s", e)
        return False


def _get_effective_config_value(key: str) -> tuple[bool, str]:
    """
    Determina el valor efectivo de una config key considerando overrides.
    Devuelve (is_active, detail_string).
    """
    overrides = _load_overrides()

    # Mapeo de keys → settings attr
    setting_map = {
        "EMAIL_PROVIDER": ("email_provider", "smtp"),
        "OLLAMA_ENABLED": ("ollama_enabled", "true"),
    }
    if key not in setting_map:
        return False, f"unknown config key: {key}"

    attr, true_val = setting_map[key]

    # Si hay override, usarlo; si no, usar el valor de settings (de .env)
    if key in overrides:
        override_val = overrides[key]
        if isinstance(override_val, bool):
            return override_val, f"override: {key}={override_val}"
        return bool(override_val), f"override: {key}={override_val}"

    # Leer desde settings (que ya incluye overrides aplicados al startup)
    current = getattr(settings, attr, "")
    if key == "EMAIL_PROVIDER":
        is_active = current not in ("", "none", None)
    else:
        is_active = current in (True, "true", "1", "yes", "True", 1)
    return is_active, f"{key}={current}"


def _toggle_config_override(key: str, enabled: bool) -> tuple[bool, str]:
    """
    Escribe un override en config_overrides.json. Requiere restart del relay
    para aplicar (los overrides se aplican al inicio en config.py).
    """
    setting_map = {
        "EMAIL_PROVIDER": ("email_provider", "smtp"),
        "OLLAMA_ENABLED": ("ollama_enabled", bool),
    }
    if key not in setting_map:
        return False, f"unknown config key: {key}"

    attr, true_val = setting_map[key]

    overrides = _load_overrides()
    if true_val == bool:
        overrides[key] = enabled
    else:
        overrides[key] = true_val if enabled else ""

    if not _save_overrides(overrides):
        return False, "failed to save overrides file"

    # Aplicar in-memory también (para que el status refleje el cambio inmediato)
    try:
        if true_val == bool:
            setattr(settings, attr, enabled)
        else:
            setattr(settings, attr, true_val if enabled else "")
    except Exception:
        pass

    return True, f"{key} override set to {enabled}; relay restart recommended"


# ──────────────────────────────────────────────
# Endpoints: GET (status)
# ──────────────────────────────────────────────

@router.get("/dashboard", response_class=HTMLResponse)
async def dashboard_html(request: Request):
    """Sirve el HTML del dashboard (SPA). Auth: X-Api-Key."""
    # Verificar auth opcional — si no hay API key configureada, servir igual
    # para desarrollo local
    if settings.relay_api_key and settings.relay_api_key != "changeme":
        key = request.headers.get("X-Api-Key") or request.headers.get("x-api-key")
        if not key or key != settings.relay_api_key:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                headers={"WWW-Authenticate": "X-Api-Key"},
                detail="unauthorized",
            )
    return HTMLResponse(content=_HTML_TEMPLATE, status_code=200)


@router.get("/api/v1/dashboard/status", response_class=JSONResponse)
async def dashboard_status(request: Request):
    """JSON con el estado de todos los componentes."""
    await verify_api_key(request)
    status_data = await gather_status()
    return JSONResponse(content=status_data)


@router.get("/api/v1/dashboard/config", response_class=JSONResponse)
async def dashboard_config(request: Request):
    """JSON con valores de .env relevantes para el dashboard."""
    await verify_api_key(request)
    env_vals = {}
    for key in [
        "WAZUH_SERVER_IP", "WAHA_HOST", "WAHA_SESSION", "RELAY_WORKERS",
        "RELAY_PORT", "EMAIL_PROVIDER", "OLLAMA_ENABLED", "OLLAMA_HOST",
        "SMTP_HOST", "HYVOR_BASE_URL", "WAHA_RECOVERY_COOLDOWN_SEC",
        "WAHA_WATCHDOG_INTERVAL_SEC", "RELAY_DEDUP_TTL",
        "RELAY_MIN_LEVEL_UNKNOWN",
    ]:
        val = os.environ.get(key, "")
        # Enmascarar secrets
        if key in ("WAHA_API_KEY",) and val:
            val = f"{val[:4]}...{val[-4:]}" if len(val) > 8 else "***"
        env_vals[key] = val

    return JSONResponse(content={
        "env": env_vals,
        "settings": {
            "relay_api_key_configured": bool(settings.relay_api_key) and settings.relay_api_key != "changeme",
            "email_provider": settings.email_provider,
            "ollama_enabled": settings.ollama_enabled,
            "waha_host": settings.waha_host,
            "waha_session": settings.waha_session,
            "relay_workers": settings.relay_workers,
            "relay_port": settings.relay_port,
            "relay_min_level_unknown": settings.relay_min_level_unknown,
            "relay_dedup_ttl": settings.relay_dedup_ttl,
        },
    })


# ──────────────────────────────────────────────
# Endpoints: POST (toggle + action) — Fase 2
# ──────────────────────────────────────────────

@router.post("/api/v1/dashboard/toggle")
async def dashboard_toggle(request: Request):
    """Toggle un componente on/off. Body: { target, enabled }"""
    await verify_api_key(request)
    body = await request.json()
    target: str = body.get("target", "")
    enabled: bool = body.get("enabled", True)

    if not target:
        raise HTTPException(status_code=400, detail="target required")

    comp = next((c for c in COMPONENTS if c["id"] == target), None)
    if comp is None:
        raise HTTPException(status_code=404, detail=f"unknown target: {target}")

    if not comp["toggleable"]:
        raise HTTPException(status_code=400, detail=f"{target} is not toggleable")

    stype = comp["status_type"]
    log.info("dashboard_toggle target=%s enabled=%s user=%s", target, enabled,
             request.client.host if request.client else "?")

    if stype == "systemd_timer":
        ok, msg = _toggle_systemd(comp["unit"], enabled)
        return {"ok": ok, "result": msg, "target": target, "enabled": enabled}

    elif stype == "waha_session":
        ok, msg = _toggle_waha_session(enabled)
        return {"ok": ok, "result": msg, "target": target, "enabled": enabled}

    elif stype == "config_toggle":
        ok, msg = _toggle_config_override(comp["config_key"], enabled)
        return {"ok": ok, "result": msg, "target": target, "enabled": enabled,
                "note": "relay restart recommended for full effect"}

    elif stype == "wazuh_rules":
        return {
            "ok": False, "result": "wazuh_rules toggle not implemented yet",
            "target": target, "enabled": enabled,
            "note": "requires SSH to Wazuh manager VM (Fase 3)"
        }

    else:
        raise HTTPException(status_code=400, detail=f"unsupported toggle type: {stype}")


@router.post("/api/v1/dashboard/action")
async def dashboard_action(request: Request):
    """Perform an action on a component. Body: { target, action }"""
    await verify_api_key(request)
    body = await request.json()
    target: str = body.get("target", "")
    action: str = body.get("action", "")

    if not target or not action:
        raise HTTPException(status_code=400, detail="target and action required")

    comp = next((c for c in COMPONENTS if c["id"] == target), None)
    if comp is None:
        raise HTTPException(status_code=404, detail=f"unknown target: {target}")

    log.info("dashboard_action target=%s action=%s user=%s", target, action,
             request.client.host if request.client else "?")

    if action == "restart" and comp["status_type"] == "systemd_service":
        ok, msg = _restart_service(comp["unit"])
        return {"ok": ok, "result": msg, "target": target, "action": action}

    elif action == "start" and comp["status_type"] == "waha_session":
        ok, msg = _toggle_waha_session(True)
        return {"ok": ok, "result": msg, "target": target, "action": action}

    elif action == "stop" and comp["status_type"] == "waha_session":
        ok, msg = _toggle_waha_session(False)
        return {"ok": ok, "result": msg, "target": target, "action": action}

    else:
        raise HTTPException(status_code=400, detail=f"unsupported action '{action}' for {target}")


# ──────────────────────────────────────────────
# HTML del dashboard (SPA self-contained)
# ──────────────────────────────────────────────

_HTML_TEMPLATE = """<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>wazuh-waha Dashboard</title>
<style>
  :root {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --card-border: #33415b;
    --text: #f1f5f9;
    --text-dim: #94a3b8;
    --green: #22c55e;
    --yellow: #eab308;
    --red: #ef4444;
    --gray: #6b7280;
    --blue: #3b82f6;
    --accent: #3b82f6;
    --toggle-bg: #33415b;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding: 24px;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .header h1 { font-size: 1.8rem; font-weight: 700; }
  .header h1 .dot { color: var(--green); }
  .header-right { display: flex; align-items: center; gap: 12px; }
  .refresh-btn {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    color: var(--text);
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }
  .refresh-btn:hover { border-color: var(--accent); }
  .refresh-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .last-refresh { font-size: 0.8rem; color: var(--text-dim); }
  .host-info { font-size: 0.8rem; color: var(--text-dim); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .category-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-dim);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 16px;
    transition: border-color 0.2s;
  }
  .card .badge {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: middle;
  }
  .badge.healthy { background: var(--green); }
  .badge.warning { background: var(--yellow); }
  .badge.error { background: var(--red); }
  .badge.disabled { background: var(--gray); }
  .badge.unknown { background: var(--gray); }
  .card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .card-header .icon { font-size: 1.4rem; }
  .card-header .name { font-weight: 600; font-size: 1.05rem; }
  .card .description { font-size: 0.8rem; color: var(--text-dim); margin-bottom: 10px; }
  .card .detail { font-size: 0.85rem; color: var(--text-dim); margin-bottom: 12px; }
  .card .status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
  }
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--toggle-bg);
    border-radius: 24px;
    transition: 0.2s;
  }
  .toggle-slider:before {
    content: "";
    position: absolute;
    height: 18px; width: 18px;
    left: 3px; bottom: 3px;
    border-radius: 50%;
    background: white;
    transition: 0.2s;
  }
  .toggle-switch input:checked + .toggle-slider { background: var(--green); }
  .toggle-switch input:checked + .toggle-slider:before { transform: translateX(20px); }
  .toggle-switch.input:disabled + .toggle-slider { opacity: 0.5; cursor: not-allowed; }
  .action-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .action-btn:hover { opacity: 0.85; }
  .action-btn.secondary { background: var(--card-bg); border: 1px solid var(--card-border); color: var(--text); }
  .actions-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .loading { opacity: 0.5; pointer-events: none; }
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--green);
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    z-index: 1000;
    animation: slideIn 0.3s ease;
  }
  .toast.error { border-left-color: var(--red); }
  @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .auth-modal {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center;
    z-index: 2000;
  }
  .auth-modal .box { background: var(--card-bg); padding: 24px; border-radius: 12px; border: 1px solid var(--card-border); }
  .auth-modal input { width: 100%; padding: 10px; background: var(--bg); border: 1px solid var(--card-border); border-radius: 6px; color: var(--text); margin-bottom: 12px; }
  .auth-modal button { width: 100%; padding: 10px; background: var(--accent); color: white; border: none; border-radius: 6px; cursor: pointer; }
</style>
</head>
<body>
  <div class="header">
    <h1><span class="dot">●</span> wazuh-waha Dashboard</h1>
    <div class="header-right">
      <span class="host-info" id="hostInfo">—</span>
      <span class="last-refresh" id="lastRefresh">—</span>
      <button class="refresh-btn" id="refreshBtn" onclick="refreshStatus()">↻ Refresh</button>
    </div>
  </div>
  <div id="grid"></div>

  <div id="authModal" class="auth-modal">
    <div class="box">
      <h3 style="margin-bottom:12px">API Key requerida</h3>
      <input type="password" id="apiKeyInput" placeholder="X-Api-Key" autocomplete="off">
      <button onclick="saveApiKey()">Acceder</button>
    </div>
  </div>

  <div id="toast" class="toast" style="display:none"></div>

<script>
const API_BASE = '/api/v1/dashboard';
const RELAY_API_KEY = localStorage.getItem('wazuh_waha_api_key') || '';

async function apiFetch(path, opts={}) {
  const headers = {'Content-Type': 'application/json'};
  if (RELAY_API_KEY) headers['X-Api-Key'] = RELAY_API_KEY;
  const r = await fetch(path, {...opts, headers});
  if (r.status === 401) {
    document.getElementById('authModal').style.display = 'flex';
    throw new Error('unauthorized');
  }
  return r;
}

function showToast(msg, isError=false) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  t.style.borderLeftColor = isError ? '#ef4444' : '#22c55e';
  setTimeout(() => t.style.display='none', 4000);
}

function saveApiKey() {
  const k = document.getElementById('apiKeyInput').value.trim();
  if (k) { localStorage.setItem('wazuh_waha_api_key', k); window.location.reload(); }
}

// Si no hay API key, mostrar modal
if (!RELAY_API_KEY) {
  document.getElementById('authModal').style.display = 'flex';
}

// También permitir Enter en el modal
document.getElementById('apiKeyInput').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') saveApiKey();
});

const CATEGORY_ORDER = ['whatsapp','services','watchdogs','notifications','wazuh_rules'];
const CATEGORY_LABELS = {
  'whatsapp': 'WhatsApp', 'services': 'Services', 'watchdogs': 'Watchdogs & Timers',
  'notifications': 'Notification Channels', 'wazuh_rules': 'Wazuh Rule Groups'
};

async function refreshStatus() {
  const btn = document.getElementById('refreshBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Refresh';
  try {
    const r = await apiFetch(API_BASE + '/status');
    const data = await r.json();
    renderStatus(data);
    document.getElementById('hostInfo').textContent = 'Host: ' + (data.host || '?');
    document.getElementById('lastRefresh').textContent = 'Últ.: ' + new Date().toLocaleTimeString();
  } catch(e) {
    if (e.message !== 'unauthorized') showToast('Error: ' + e.message, true);
  } finally {
    btn.disabled = false;
    btn.textContent = '↻ Refresh';
  }
}

function renderStatus(data) {
  const grid = document.getElementById('grid');
  grid.innerHTML = '';

  const byCat = {};
  data.components.forEach(c => {
    if (!byCat[c.category]) byCat[c.category] = [];
    byCat[c.category].push(c);
  });

  for (const cat of CATEGORY_ORDER) {
    const comps = byCat[cat];
    if (!comps) continue;
    const title = document.createElement('div');
    title.className = 'category-title';
    title.textContent = CATEGORY_LABELS[cat] || cat;
    grid.appendChild(title);

    comps.forEach(comp => {
      const card = document.createElement('div');
      card.className = 'card';
      card.id = 'card-' + comp.id;

      const healthColor = {'healthy':'#22c55e','warning':'#eab308','error':'#ef4444','disabled':'#6b7280','unknown':'#6b7280'}[comp.health] || '#6b7280';

      let header = '<div class="card-header">' +
        '<span class="icon">' + comp.icon + '</span>' +
        '<span class="name">' + comp.name + '</span>' +
        '<span class="badge ' + comp.health + '" style="background:' + healthColor + '"></span>' +
        '</div>';

      let desc = '<div class="description">' + comp.description + '</div>';
      let detail = '<div class="detail">' + comp.detail + '</div>';

      // Build status row (toggle + actions)
      let controls = '<div class="status-row">';

      if (comp.toggleable) {
        const checked = comp.current_state ? 'checked' : '';
        controls += '<label class="toggle-switch">' +
          '<input type="checkbox" ' + checked + ' onchange="onToggle(\'' + comp.id + '\', this.checked)" ' +
          (comp.health === 'unknown' ? 'disabled' : '') + '>' +
          '<span class="toggle-slider"></span></label>';
      } else {
        controls += '<div style="width:44px"></div>';
      }

      controls += '<div class="actions-row">';
      if (comp.actions && comp.actions.length > 0) {
        comp.actions.forEach(act => {
          controls += '<button class="action-btn" onclick="onAction(\'' + comp.id + '\',\'' + act + '\')">' + act + '</button>';
        });
      }
      if (!comp.toggleable && !comp.actions.length) {
        controls += '<span style="color:var(--text-dim); font-size:0.8rem">—</span>';
      }
      controls += '</div>';
      controls += '</div>';

      card.innerHTML = header + desc + detail + controls;
      grid.appendChild(card);
    });
  }
}

async function onToggle(target, enabled) {
  const card = document.getElementById('card-' + target);
  card.classList.add('loading');
  try {
    const r = await apiFetch(API_BASE + '/toggle', {
      method: 'POST',
      headers: {'Content-Type':'application/json','X-Api-Key':RELAY_API_KEY},
      body: JSON.stringify({target, enabled})
    });
    const result = await r.json();
    if (result.ok) {
      showToast(target + ': ' + result.result);
      setTimeout(refreshStatus, 1500);
    } else {
      showToast('Error: ' + result.result, true);
    }
  } catch(e) {
    showToast('Error: ' + e.message, true);
  } finally {
    card.classList.remove('loading');
  }
}

async function onAction(target, action) {
  const card = document.getElementById('card-' + target);
  card.classList.add('loading');
  try {
    const r = await apiFetch(API_BASE + '/action', {
      method: 'POST',
      headers: {'Content-Type':'application/json','X-Api-Key':RELAY_API_KEY},
      body: JSON.stringify({target, action})
    });
    const result = await r.json();
    if (result.ok) {
      showToast(target + ': ' + result.result);
    } else {
      showToast('Error: ' + result.result, true);
    }
  } catch(e) {
    showToast('Error: ' + e.message, true);
  } finally {
    card.classList.remove('loading');
  }
}

// Auto-refresh cada 5 segundos
let _refreshTimer = null;
function startAutoRefresh() {
  _refreshTimer = setInterval(refreshStatus, 5000);
}

// Init
refreshStatus();
startAutoRefresh();
</script>
</body>
</html>"""
